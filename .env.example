MONGO_ROOT_USER='librechat'
MONGO_ROOT_PASS=''
MONGO_BIND_IP='127.0.0.1'
LC_PORT='3080'
# Branding instellingen
# Opties voor BRANDING_MODE:
# - govchat   (Default: gebruikt de GovChat-NL-logo's uit ./branding)
# - custom    (Gebruikt je eigen logo's uit ./custom-branding)
# - librechat (Originele LibreChat-logo's, geen overrides)
BRANDING_MODE='govchat'
# Betere Nederlandse LibreChat-vertalingen toepassen (true/false; standaard true).
LIBRECHAT_NL_TRANSLATIONS_ENABLED='true'
# Opt-in minimal chat UI; requires docker-compose.override.yml (true/false).
GOVCHAT_MINIMAL_UI='false'
APP_TITLE='GovChat-NL'
PUBLIC_BASE_URL='http://localhost:3080'
ADMIN_PANEL_PUBLIC_URL='http://localhost:3100'
LIBRECHAT_CONFIG_PATH='./librechat.yaml'
POSTGRES_DB='librechat_rag'
POSTGRES_USER='librechat'
POSTGRES_PASSWORD=''
MEILI_MASTER_KEY=''
JWT_SECRET=''
JWT_REFRESH_SECRET=''
SESSION_SECRET=''
CREDS_KEY=''
CREDS_IV=''
ENTRA_TENANT_ID=''
OPENID_CLIENT_ID=''
OPENID_CLIENT_SECRET=''
OPENID_SESSION_SECRET=''
OPENID_REQUIRED_ROLE='LibreChat.Access'
LITELLM_URL='http://litellm:4000'
LITELLM_API_KEY=''
OPENAI_API_KEY=''
LITELLM_CONFIG_PATH='./litellm/config.yaml'
AZURE_OPENAI_API_BASE=''
AZURE_OPENAI_API_VERSION='2023-05-15'
AZURE_OPENAI_API_KEY=''
# Speech-to-text (audio transcription) deployment for model alias `whisper`
# Use the full Azure OpenAI endpoint base, e.g.:
# https://<resource>.openai.azure.com/openai/deployments/<stt-deployment>
AZURE_OPENAI_STT_API_BASE=''
AZURE_OPENAI_STT_API_VERSION='2024-02-15-preview'
AZURE_OPENAI_STT_API_KEY=''

# Optional: second speech-to-text backend alias via LiteLLM (`stt-next`)
# Keep empty if you only use `whisper`.
# Example model values:
# - azure/gpt-4o-transcribe-2
# - azure/whisper-1
LITELLM_STT_NEXT_MODEL=''
LITELLM_STT_NEXT_API_BASE=''
LITELLM_STT_NEXT_API_VERSION=''
LITELLM_STT_NEXT_API_KEY=''

# Realtime speech-to-text bridge (GovChat Overlay Admin)
REALTIME_STT_TOKEN=''
REALTIME_STT_PROVIDER='litellm' # litellm | azure
LITELLM_REALTIME_URL='http://litellm:4000/v1/realtime'
LITELLM_REALTIME_MODEL='gpt-4o-realtime-preview'
LITELLM_REALTIME_API_KEY=''
AZURE_OPENAI_REALTIME_API_BASE=''
AZURE_OPENAI_REALTIME_API_VERSION=''
AZURE_OPENAI_REALTIME_API_KEY=''
AZURE_OPENAI_REALTIME_MODEL=''
N8N_OPENAI_BRIDGE_BEARER_TOKEN='change_me_bridge_token'
LITELLM_POSTGRES_PASSWORD=''
LITELLM_MASTER_KEY=''
LITELLM_SALT_KEY=''
LITELLM_UI_USERNAME='litellmadmin'
LITELLM_UI_PASSWORD=''
LITELLM_PORT='4000'
LITELLM_LOG_LEVEL='WARNING'
LITELLM_NUM_WORKERS='1'
LITELLM_DB_POOL_LIMIT='10'
LITELLM_DB_TIMEOUT='30'
ADMIN_SESSION_SECRET=''
GOVCHAT_ADMIN_PASSWORD=''
GOVCHAT_OVERLAY_CORS_ORIGIN='https://chat.organisatie.nl'
GOVCHAT_OVERLAY_ADMIN_PORT='3002'

# n8n (verplicht als Versimpelaar via n8n draait)
N8N_VERSION='2.25.7'
N8N_POSTGRES_PASSWORD=''
N8N_ENCRYPTION_KEY=''
N8N_BASIC_AUTH_USER='n8nadmin'
N8N_BASIC_AUTH_PASSWORD='change_me_n8n_password'
N8N_WEBHOOK_TOKEN='change_me_very_long_random_token'
N8N_RUNNERS_AUTH_TOKEN='change_me_another_very_long_random_token'
N8N_RUNNERS_TASK_REQUEST_TIMEOUT='120'
N8N_RUNNERS_GRANT_TOKEN_TTL='120'
N8N_OWNER_EMAIL=''
N8N_OWNER_PASSWORD='' # n8n vereist minimaal 1 hoofdletter en 1 cijfer
N8N_OWNER_FIRST_NAME='GovChat'
N8N_OWNER_LAST_NAME='Admin'

# GovChat data retention (settings are independent; the dedicated worker sweeps on the configured interval)
# Chats are deleted by the GovChat inactivity sweep; the hours value also bounds temporary chats in LibreChat.
GOVCHAT_CHAT_RETENTION_HOURS='720' # 30 days since the latest message
GOVCHAT_UPLOAD_RETENTION_DAYS='30'
GOVCHAT_PROMPT_RETENTION_DAYS='730' # conservative age fallback, not a last-use timestamp
GOVCHAT_GENERATED_IMAGE_RETENTION_DAYS='30'
GOVCHAT_RETENTION_SWEEP_INTERVAL_MINUTES='60'

# n8n: persist failed executions only. 718h leaves time for both native prune sweeps
# while ensuring hard deletion completes within 30 days.
N8N_EXECUTION_RETENTION_HOURS='718'
N8N_EXECUTION_HARD_DELETE_BUFFER_HOURS='0'
N8N_EXECUTION_HARD_DELETE_INTERVAL_MINUTES='15'
N8N_EXECUTION_SOFT_DELETE_INTERVAL_MINUTES='60'
N8N_LOG_RETENTION_DAYS='30'
N8N_LOG_FILE_SIZE_MAX='10485760' # 10 MiB per n8n file; hourly log-pruner rotation
N8N_LOG_FILE_COUNT_MAX='1000'
N8N_LOG_PRUNE_INTERVAL_SECONDS='3600'
N8N_LOG_MAX_SIZE='10m'
N8N_LOG_MAX_FILES='10'
# Optionele image-generation feature voor orchestrator
# false = image tool beschikbaar maar geeft nette "uitgeschakeld" melding terug
# true  = image generation actief (vereist geldige image model + key)
N8N_ENABLE_IMAGE_TOOL='false'

# Optioneel overschrijven voor image generatie; vallen terug op LITELLM_* als leeg
N8N_LITELLM_IMAGE_BASE_URL='http://litellm:4000'
N8N_LITELLM_IMAGE_API_KEY=''
N8N_LITELLM_IMAGE_MODEL='gpt-image-1'

# Async image-jobs API (via govchat-overlay-admin)
IMAGE_JOBS_ENABLED='false'
IMAGE_JOBS_WEBHOOK_URL='http://n8n:5678/webhook/image-generator'
IMAGE_JOBS_WEBHOOK_TOKEN=''
IMAGE_JOBS_CONCURRENCY='1'
IMAGE_JOBS_TTL_HOURS='24'

AGENTS_LOCAL_WORKFLOWS_DIR='/workspace/agents/n8n/workflows'
AGENTS_BOOTSTRAP_FORCE='false'

# TOPdesk API host is assembled as https://<tenant>.<base-domain> by n8n-bootstrap.
TOPDESK_TENANT=''
TOPDESK_BASE_DOMAIN='topdesk.net'
# Optional SSP link base, e.g. https://topdesk.<tenant>.nl/tas/public/ssp/content/detail/knowledgeitem
TOPDESK_PUBLIC_BASE_URL=''
# Imported by n8n-bootstrap as an encrypted n8n HTTP Basic Auth credential.
TOPDESK_API_USERNAME=''
TOPDESK_API_PASSWORD=''
# Opt-in: bootstrap koppelt TOPdesk Search als AI-tool aan de orchestrator.
# Dit publiceert alleen de zoekworkflow; ingest/planning blijven opt-in.
N8N_ENABLE_TOPDESK_SEARCH='false'

# Apache Tika voor optionele tekstextractie uit TOPdesk-kennisitembijlagen.
# TIKA_URL in de workflowconfig moet vanuit het Docker-netwerk bereikbaar zijn.
TIKA_VERSION='3.2.3.0-full'

# Overheidscrawler (allowlist + robots.txt via n8n + overlay admin)
CRAWLER_ADMIN_BASE_URL='http://govchat-overlay-admin:3002'
CRAWLER_INTERNAL_TOKEN=''
CRAWLER_N8N_WEBHOOK_URL='http://n8n:5678/webhook/govcrawler-run'
CRAWLER_N8N_WEBHOOK_TOKEN=''
CRAWLER_RUNS_LIMIT='200'

# Aanbevolen embedding alias via LiteLLM config.yaml
CRAWLER_EMBEDDING_MODEL='govchat-embedding'
TZ='Europe/Amsterdam'

# Alleen nodig bij Compose-profiel `admin` voor pgAdmin
PGADMIN_DEFAULT_EMAIL='admin@local.test'
PGADMIN_DEFAULT_PASSWORD='change_me_pgadmin_password'

# Dev-only LibreChat admin seeder (alleen voor lokale/dev omgevingen)
DEV_SEED_ADMIN_ENABLED='false'
DEV_SEED_ADMIN_NAME='Local Admin'
DEV_SEED_ADMIN_EMAIL='admin@local.test'
DEV_SEED_ADMIN_PASSWORD='ChangeMe!123'

# Deployment portability (keep installation values in your private .env).
GOVCHAT_DATA_ROOT='/opt/librechat'
GOVCHAT_NETWORK_NAME='librechat-net'
GOVCHAT_NETWORK_EXTERNAL='false'
MONGO_IMAGE='mongo:8.0.20'
N8N_OPENAI_BRIDGE_BUILD_CONTEXT='../n8n-openai-bridge-main'
LC_BIND_IP='0.0.0.0'
# Empty derives the host from PUBLIC_BASE_URL, plus localhost/librechat-proxy.
GOVCHAT_SERVER_NAMES=''
GOVCHAT_BLOCK_PASSWORD_AUTH='false'
NGINX_TRUSTED_PROXIES_CONF_PATH='./nginx/trusted-proxies.conf'
NGINX_TRUSTED_PROXIES_GEO_PATH='./nginx/trusted-proxies.geo'

# Admin role mapping is opt-in. Roles must be assigned by your identity provider.
OPENID_ADMIN_ROLE=''
OPENID_ADMIN_ROLE_TOKEN_KIND='id'
OPENID_ADMIN_ROLE_PARAMETER_PATH='roles'
ADMIN_SSO_ONLY='false'
ADMIN_PANEL_IMAGE='ghcr.io/clickhouse/librechat-admin-panel:latest'
ADMIN_PANEL_API_SERVER_URL='http://librechat-proxy:3080'
ADMIN_PANEL_PORT='3100'
# Optional docker-compose.admin-panel-build.yml (build-time AND runtime base).
ADMIN_PANEL_BASE_PATH='/'
ADMIN_PANEL_BUILD_IMAGE='govchat-admin-panel:subpath'
# ADMIN_PANEL_BUILD_CONTEXT may point to another reviewed revision/local checkout.

# Optional n8n editor ingress; webhook URL is separate from editor URL/path.
N8N_PATH='/'
N8N_EDITOR_BASE_URL='http://localhost:5678'
N8N_WEBHOOK_URL='http://localhost:5678'
N8N_PROXY_HOPS='0'
N8N_SECURE_COOKIE='true'

# Optional docker-compose.management.yml: adapters are always loopback-bound.
N8N_MANAGEMENT_PORT='5678'
QDRANT_MANAGEMENT_PORT='6333'
MEILI_MANAGEMENT_PORT='7700'
BRIDGE_MANAGEMENT_PORT='3333'
MANAGEMENT_SINK_PORT='8080'
N8N_MANAGEMENT_PATH='/'
QDRANT_MANAGEMENT_PATH='/'
MANAGEMENT_FORWARDED_PROTO='https'

# Authentication/Graph overrides are deliberately not assigned here: the base
# and docker-compose.sso-only.yml supply their own documented defaults.
# ALLOW_REGISTRATION, ALLOW_EMAIL_LOGIN, ALLOW_PASSWORD_RESET,
# ALLOW_SOCIAL_LOGIN, ALLOW_SOCIAL_REGISTRATION, OPENID_SCOPE,
# OPENID_REUSE_TOKENS, USE_ENTRA_ID_FOR_PEOPLE_SEARCH, OPENID_GRAPH_SCOPES,
# OPENID_ON_BEHALF_FLOW_FOR_USERINFO_REQUIRED.
