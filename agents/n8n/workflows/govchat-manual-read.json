[
  {
    "id": "govchat-manual-read",
    "name": "GovChat gepubliceerde handleiding lezen",
    "active": true,
    "nodes": [
      {
        "id": "trigger",
        "name": "Manual Input",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1.1,
        "position": [
          0,
          0
        ],
        "parameters": {
          "inputSource": "workflowInputs",
          "workflowInputs": {
            "values": [
              {
                "name": "request",
                "type": "string"
              }
            ]
          }
        }
      },
      {
        "id": "prepare",
        "name": "Prepare Manual Request",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "parameters": {
          "jsCode": "\nconst raw = $json.request;\nif (typeof raw !== 'string' || raw.length > 2048) throw new Error('Handleiding: ongeldige invoer');\nlet request; try { request = JSON.parse(raw); } catch { throw new Error('Handleiding: JSON vereist'); }\nif (!request || Array.isArray(request) || typeof request !== 'object' || Object.keys(request).some(k => !['action','query','id','revision','limit'].includes(k))) throw new Error('Handleiding: onbekende velden');\nconst token = String($env.CRAWLER_INTERNAL_TOKEN || $env.N8N_WEBHOOK_TOKEN || '').trim();\nif (!token) throw new Error('Handleiding: interne authenticatie ontbreekt');\nconst base = String($env.CRAWLER_ADMIN_BASE_URL || 'http://govchat-overlay-admin:3002').replace(/\\/$/, '');\nreturn [{json:{request,token,url:base + '/api/internal/manual'}}];"
        }
      },
      {
        "id": "http",
        "name": "Read Authenticated Manual",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          440,
          0
        ],
        "parameters": {
          "method": "POST",
          "url": "={{ $json.url }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $json.token }}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json.request) }}",
          "options": {
            "timeout": 10000,
            "response": {
              "response": {
                "responseFormat": "json",
                "neverError": true
              }
            }
          }
        }
      },
      {
        "id": "result",
        "name": "Return Manual Sources",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          660,
          0
        ],
        "parameters": {
          "jsCode": "if (!$json || typeof $json.ok !== 'boolean' || JSON.stringify($json).length > 32000) throw new Error('Handleiding niet beschikbaar: ongeldig backendantwoord');\nreturn [{json:{response:JSON.stringify($json)}}];"
        }
      }
    ],
    "connections": {
      "Manual Input": {
        "main": [
          [
            {
              "node": "Prepare Manual Request",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Prepare Manual Request": {
        "main": [
          [
            {
              "node": "Read Authenticated Manual",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Read Authenticated Manual": {
        "main": [
          [
            {
              "node": "Return Manual Sources",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "saveDataSuccessExecution": "none",
      "saveDataErrorExecution": "none",
      "saveManualExecutions": false,
      "saveExecutionProgress": false
    }
  }
]
